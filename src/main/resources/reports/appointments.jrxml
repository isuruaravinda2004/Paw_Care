<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="appointments" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="32" whenNoDataType="AllSectionsNoDetail">
<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10" forecolor="#20354A"/>
<parameter name="FROM_DATE" class="java.sql.Date"/>
<parameter name="TO_DATE" class="java.sql.Date"/>
<parameter name="PAYMENT_ID" class="java.lang.Integer"/>
<queryString><![CDATA[SELECT c.name AS customer_name,p.pet_name,s.service_name,a.appointment_date,a.appointment_time,a.status
FROM appointments a JOIN customers c ON a.customer_id=c.customer_id
JOIN pets p ON a.pet_id=p.pet_id JOIN services s ON a.service_id=s.service_id
WHERE a.appointment_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE}
ORDER BY a.appointment_date,a.appointment_time]]></queryString>
<field name="customer_name" class="java.lang.String"/>
<field name="pet_name" class="java.lang.String"/>
<field name="service_name" class="java.lang.String"/>
<field name="appointment_date" class="java.sql.Date"/>
<field name="appointment_time" class="java.sql.Time"/>
<field name="status" class="java.lang.String"/>
<title><band height="88">
<staticText><reportElement x="0" y="0" width="762" height="32"/><textElement><font size="24" isBold="true"/></textElement><text><![CDATA[PawCare | Appointments]]></text></staticText>
<staticText><reportElement x="0" y="38" width="762" height="20"/><text><![CDATA[PET GROOMING CENTER MANAGEMENT]]></text></staticText>
<textField><reportElement x="0" y="63" width="762" height="18"/><textFieldExpression><![CDATA["Period: " + $P{FROM_DATE} + " to " + $P{TO_DATE}]]></textFieldExpression></textField>
</band></title><columnHeader><band height="30"><staticText><reportElement mode="Opaque" x="0" y="0" width="145" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Customer]]></text></staticText><staticText><reportElement mode="Opaque" x="145" y="0" width="90" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Pet]]></text></staticText><staticText><reportElement mode="Opaque" x="235" y="0" width="165" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Service]]></text></staticText><staticText><reportElement mode="Opaque" x="400" y="0" width="100" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText><staticText><reportElement mode="Opaque" x="500" y="0" width="92" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Time]]></text></staticText><staticText><reportElement mode="Opaque" x="592" y="0" width="170" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText></band></columnHeader><detail><band height="36" splitType="Stretch"><textField textAdjust="StretchHeight"><reportElement x="0" y="0" width="145" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="145" y="0" width="90" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{pet_name}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="235" y="0" width="165" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{service_name}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" pattern="yyyy-MM-dd"><reportElement x="400" y="0" width="100" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{appointment_date}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" pattern="HH:mm"><reportElement x="500" y="0" width="92" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{appointment_time}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="592" y="0" width="170" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField></band></detail><pageFooter><band height="22"><textField><reportElement x="0" y="3" width="650" height="18"/><textFieldExpression><![CDATA["PawCare  |  Generated " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression></textField><textField><reportElement x="670" y="3" width="92" height="18"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter><summary><band height="45"><textField><reportElement x="0" y="18" width="762" height="24"/><textElement><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA["Records: " + $V{REPORT_COUNT}]]