<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="payments" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="32" whenNoDataType="AllSectionsNoDetail">
<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10" forecolor="#20354A"/>
<parameter name="FROM_DATE" class="java.sql.Date"/>
<parameter name="TO_DATE" class="java.sql.Date"/>
<parameter name="PAYMENT_ID" class="java.lang.Integer"/>
<queryString><![CDATA[SELECT p.payment_id,c.name AS customer_name,s.service_name,p.amount,p.payment_method,p.payment_date
FROM payments p JOIN appointments a ON p.appointment_id=a.appointment_id
JOIN customers c ON a.customer_id=c.customer_id JOIN services s ON a.service_id=s.service_id
WHERE p.payment_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE}
ORDER BY p.payment_date,p.payment_id]]></queryString>
<field name="payment_id" class="java.lang.Integer"/>
<field name="customer_name" class="java.lang.String"/>
<field name="service_name" class="java.lang.String"/>
<field name="amount" class="java.math.BigDecimal"/>
<field name="payment_method" class="java.lang.String"/>
<field name="payment_date" class="java.sql.Date"/>
<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{amount}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
<title><band height="88">
<staticText><reportElement x="0" y="0" width="762" height="32"/><textElement><font size="24" isBold="true"/></textElement><text><![CDATA[PawCare | Payment summary]]></text></staticText>
<staticText><reportElement x="0" y="38" width="762" height="20"/><text><![CDATA[PET GROOMING CENTER MANAGEMENT]]></text></staticText>
<textField><reportElement x="0" y="63" width="762" height="18"/><textFieldExpression><![CDATA["Period: " + $P{FROM_DATE} + " to " + $P{TO_DATE}]]></textFieldExpression></textField>
</band></title><columnHeader><band height="30"><staticText><reportElement mode="Opaque" x="0" y="0" width="60" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Receipt]]></text></staticText><staticText><reportElement mode="Opaque" x="60" y="0" width="155" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Customer]]></text></staticText><staticText><reportElement mode="Opaque" x="215" y="0" width="180" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Service]]></text></staticText><staticText><reportElement mode="Opaque" x="395" y="0" width="130" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Amount (LKR)]]></text></staticText><staticText><reportElement mode="Opaque" x="525" y="0" width="120" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Method]]></text></staticText><staticText><reportElement mode="Opaque" x="645" y="0" width="117" height="28" forecolor="#FFFFFF" backcolor="#16354C"/><box leftPadding="6" topPadding="6"/><textElement><font isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText></band></columnHeader><detail><band height="36" splitType="Stretch"><textField textAdjust="StretchHeight"><reportElement x="0" y="0" width="60" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{payment_id}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="60" y="0" width="155" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="215" y="0" width="180" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{service_name}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" pattern="#,##0.00"><reportElement x="395" y="0" width="130" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="525" y="0" width="120" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{payment_method}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" pattern="yyyy-MM-dd"><reportElement x="645" y="0" width="117" height="30"/><box leftPadding="6" topPadding="6" bottomPadding="4"><bottomPen lineWidth="0.3" lineColor="#DCE5EB"/></box><textFieldExpression><![CDATA[$F{payment_date}]]></textFieldExpression></textField></band></detail><pageFooter><band height="22"><textField><reportElement x="0" y="3" width="650" height="18"/><textFieldExpression><![CDATA["PawCare  |  Generated " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression></textField><textField><reportElement x="670" y="3" width="92" height="18"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter><summary><band height="45"><textField><reportElement x="0" y="18" width="762" height="24"/><textElement><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA["Payments: " + $V{REPORT_COUNT} + "    Total (LKR): " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL})]]></textFieldExpression></textField></band></summary></jasperReport>
